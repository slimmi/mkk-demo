{
  "name": "notebook-notes",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:code && npm run lint:styles",
    "lint:code": "eslint . --max-warnings 0",
    "lint:styles": "stylelint \"app/**/*.{scss,vue}\" --max-warnings 0",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "postinstall": "nuxt prepare",
    "test:browser": "node tests/browser/smoke.cjs"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.11.0",
    "nuxt": "^4.2.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.56.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.32",
    "postcss-html": "^2.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.10",
    "sass": "^1.93.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.1.0"
  }
}
